---
interface Props {
  heading?: string;
  subtitle?: string;
  bio?: string;
  cta?: { label: string; href: string } | null;
  secondaryCta?: { label: string; href: string } | null;
  topPadding?: string;
}

const {
  heading = "Andrea Rapuzzi",
  subtitle = "CX Lead @Nestlé Waters",
  bio = "Ciao! io sono Andrea e questo è il mio piccolo angolo di internet. Digital marketer per passione, programmatore della domenica, pessimo copywriter. Dal lunedì al venerdì mi occupo di CX in Nestlé, mentre nel weekend perdo tempo tra film, progetti sgangherati, e qualche buon vinile.",
  cta = {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/andrea-rapuzzi/",
  },
  secondaryCta = null,
  topPadding = "7rem",
} = Astro.props;
---

<section class="hero" style={`padding-top: ${topPadding}`}>
  <div class="hero__inner">
    <h1 class="hero__name">{heading}</h1>
    {subtitle && <p class="hero__title">{subtitle}</p>}
    {(bio || Astro.slots.has('bio')) && <p class="hero__bio">{bio}<slot name="bio" /></p>}
    <div class="hero__footer">
      {
        cta && (
          <div class="hero__links">
            <a href={cta.href} class="hero__link hero__link--primary">
              {cta.label}
            </a>
            {secondaryCta && (
              <a href={secondaryCta.href} class="hero__link hero__link--secondary">
                {secondaryCta.label}
              </a>
            )}
          </div>
        )
      }
      <div class="hero__deco" aria-hidden="true">
        <time class="hero__deco-time" data-clock></time>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 7rem 2rem 5rem;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .hero__name {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0em;
    color: var(--color-heading);
  }

  .hero__title {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: clamp(0.75rem, 1.4vw, 1rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-top: 0.75rem;
  }

  .hero__bio {
    max-width: 52ch;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-muted);
    margin-top: 1.75rem;
  }

  /* Riga delle CTA: l'orario è ancorato in basso a destra e non ne cambia l'altezza */
  .hero__footer {
    position: relative;
  }

  .hero__footer:has(.hero__links) {
    margin-top: 2.5rem;
  }

  .hero__links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero__link {
    font-size: 0.9375rem;
    font-weight: 500;
    transition: opacity 150ms ease, transform 160ms var(--ease-out);
  }

  .hero__link:active {
    transform: scale(0.97);
  }

  .hero__link--primary {
    background: var(--color-accent);
    color: var(--color-on-accent);
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 1.25rem;
    border-radius: 99px;
  }

  .hero__link--secondary {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 1.25rem;
    border-radius: 99px;
    border: 1px solid var(--color-border);
    color: var(--color-ink);
    transition: opacity 150ms ease, transform 160ms var(--ease-out),
      border-color 150ms ease, color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__link--primary:hover {
      opacity: 0.8;
    }

    .hero__link--secondary:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
  }

  .hero__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .hero__deco {
    display: flex;
    position: absolute;
    right: 0;
    bottom: 0.5rem;
  }

  .hero__deco-time {
    writing-mode: vertical-rl;
    font-size: 0.6875rem;
    font-weight: 300;
    letter-spacing: 0.2em;
    font-variant-numeric: tabular-nums;
    color: var(--color-teal);
    user-select: none;
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 5rem;
    }

    .hero__deco {
      display: none;
    }
  }
</style>

<script>
  // Ora italiana, indipendente dal fuso di chi visita; si aggiorna ogni secondo
  const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
  if (clock) {
    const format = new Intl.DateTimeFormat('it-IT', {
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      timeZone: 'Europe/Rome',
    });
    const tick = () => {
      const now = new Date();
      clock.textContent = format.format(now);
      clock.dateTime = now.toISOString();
      setTimeout(tick, 1000 - (now.getTime() % 1000));
    };
    tick();
  }
</script>
