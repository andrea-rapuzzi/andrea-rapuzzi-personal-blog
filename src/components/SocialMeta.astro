---
interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  type?: 'website' | 'article';
}
const {
  title,
  description: rawDescription,
  image: rawImage,
  imageAlt: rawImageAlt,
  imageWidth = 1200,
  type = 'website',
} = Astro.props;

const description = rawDescription || 'Il sito personale di Andrea Rapuzzi: articoli, libri e side project.';
const image = new URL(rawImage || '/images/og/default.png', Astro.site);
const imageAlt = (rawImage && rawImageAlt) || 'Andrea Rapuzzi — CX Lead @Nestlé Waters';
// La cover di default è 1280×630
const width = rawImage ? imageWidth : 1280;
const url = new URL(Astro.url.pathname, Astro.site);
---

<meta name="description" content={description} />
<link rel="canonical" href={url} />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content="Andrea Rapuzzi" />
<meta property="og:locale" content="it_IT" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content={String(width)} />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
