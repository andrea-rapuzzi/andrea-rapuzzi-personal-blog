---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import PostList from '../components/PostList.astro';

const allPosts = await getCollection('posts');

const posts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    title: post.data.title,
    excerpt: post.data.description,
    date: post.data.pubDate.toLocaleDateString('it-IT', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    }),
    tags: post.data.tags,
    url: `/posts/${post.id}`,
  }));

const allTags = [...new Set(posts.flatMap((p) => p.tags))].sort();
---

<Layout title="Blog — Andrea Rapuzzi">
  <main>
    <div class="blog-hero-wrap">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb__list">
          <li class="breadcrumb__item"><a href="/" class="breadcrumb__link">Home</a></li>
          <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">Blog</li>
        </ol>
      </nav>
    </div>

    <HeroSection
      heading="Blog"
      subtitle="Articoli, note e riflessioni"
      bio="Un archivio di pensieri su design, tecnologia e tutto ciò che si trova nel mezzo."
      cta={null}
    />

    <div class="blog">
      <div class="blog__inner">

        <aside class="blog__tags" aria-label="Filtra per tag">
          <h2 class="blog__tags-heading">Tag</h2>
          <ul class="blog__tag-list">
            {allTags.map((tag) => (
              <li>
                <button class="blog__tag" data-tag={tag} aria-pressed="false">{tag}</button>
              </li>
            ))}
          </ul>
        </aside>

        <div class="blog__articles">
          <PostList posts={posts} />
        </div>

      </div>
    </div>
  </main>
</Layout>

<style>
  /* ── Breadcrumb ── */
  .blog-hero-wrap {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3.5rem 2rem 0;
  }

  .breadcrumb__list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .breadcrumb__item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .breadcrumb__item + .breadcrumb__item::before {
    content: '/';
    color: var(--color-border);
  }

  .breadcrumb__link {
    color: var(--color-muted);
    transition: color 0.2s;
  }

  .breadcrumb__link:hover {
    color: var(--color-ink);
  }

  .breadcrumb__item--current {
    color: var(--color-ink);
    font-weight: 500;
  }

  .blog {
    padding: 0 2rem var(--section-gap);
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .blog__inner {
    border-top: 1px solid var(--color-border);
    padding-top: 3rem;
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* La linea sopra la sezione basta: niente doppio bordo, prima riga allineata a "tag" */
  .blog__articles :global(.post-list) {
    border-top: none;
  }

  .blog__articles :global(.post-row:first-child .post-row__link) {
    padding-top: 0.5rem;
  }

  /* Tags sidebar */
  .blog__tags-heading {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
    margin-bottom: 1.25rem;
  }

  .blog__tag-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .blog__tag {
    font: inherit;
    font-size: 0.875rem;
    text-transform: lowercase;
    color: var(--color-muted);
    background: none;
    border: none;
    padding: 0.125rem 0;
    cursor: pointer;
    border-bottom: 1px solid transparent;
    transition: color 150ms ease, border-color 150ms ease, transform 160ms var(--ease-out);
  }

  .blog__tag:active {
    transform: scale(0.97);
  }

  .blog__tag:hover {
    color: var(--color-ink);
  }

  .blog__tag[aria-pressed="true"] {
    color: var(--color-ink);
    border-bottom-color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .blog__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .blog__tag-list {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
    }
  }
</style>

<script>
  const tagButtons = document.querySelectorAll<HTMLButtonElement>('.blog__tag[data-tag]');
  const cards = document.querySelectorAll<HTMLElement>('.post-row[data-tags]');

  let active: string | null = null;

  tagButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag!;

      if (active === tag) {
        // deselect
        active = null;
        btn.setAttribute('aria-pressed', 'false');
        cards.forEach((c) => c.removeAttribute('hidden'));
      } else {
        // select new tag
        active = tag;
        tagButtons.forEach((b) => b.setAttribute('aria-pressed', b.dataset.tag === tag ? 'true' : 'false'));
        cards.forEach((c) => {
          const tags = c.dataset.tags!.split(',');
          tags.includes(tag) ? c.removeAttribute('hidden') : c.setAttribute('hidden', '');
        });
      }
    });
  });
</script>
